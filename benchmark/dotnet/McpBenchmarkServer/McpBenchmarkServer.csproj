<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>McpBenchmarkServer</RootNamespace>
    <AssemblyName>McpBenchmarkServer</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <!-- Official Microsoft MCP SDK (pre-release as of 2026-Q1) -->
    <PackageReference Include="ModelContextProtocol" Version="0.2.0-preview.3" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="0.2.0-preview.3" />
    <!-- JSON Schema validation -->
    <PackageReference Include="NJsonSchema" Version="11.3.1" />
  </ItemGroup>

</Project>
