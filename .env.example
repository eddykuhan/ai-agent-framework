# GitHub App credentials
# Get these from: https://github.com/settings/apps/<your-app-name>

# Your GitHub App's numeric ID (found in the App settings page)
GITHUB_APP_ID=123456

# Private key in PEM format.
# Option 1: Inline with literal \n for newlines
GITHUB_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEow...\n-----END RSA PRIVATE KEY-----"
# Option 2: Reference a key file in server.js via fs.readFileSync

# Default installation ID — the numeric ID shown in the installed app URL
# e.g. https://github.com/settings/installations/12345678
GITHUB_INSTALLATION_ID=12345678

# Optional — OAuth credentials for user auth flows
# GITHUB_CLIENT_ID=Iv1.abc123
# GITHUB_CLIENT_SECRET=your-client-secret

# Server port (default: 3000)
PORT=3000
